# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ตัวจริงขึ้น GitHub)

PORT=8080

# เอามาจาก Supabase > Project Settings > Database > Connection string (เลือกโหมด "Session pooler")
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# สุ่มสตริงยาวๆ เก็บเป็นความลับ ใช้เซ็น JWT ตอน login
JWT_SECRET=change-this-to-a-long-random-string

# สุ่มสตริงอีกตัว แยกจาก JWT_SECRET ใช้ป้องกัน endpoint /api/admin/* ที่ Render Cron Job เรียก
CRON_SECRET=change-this-to-another-long-random-string

# โดเมนของ frontend บน Firebase Hosting เช่น https://pixel-cardshop-pos.web.app
ALLOWED_ORIGIN=https://your-project.web.app
